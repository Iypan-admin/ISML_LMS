model Invoices {
  id            String    @id @default(uuid())
  tenantId      String
  invoiceNumber String    @unique
  amount        Decimal   @db.Decimal(10, 2)
  taxAmount     Decimal   @default(0.00) @db.Decimal(10, 2)
  totalAmount   Decimal   @db.Decimal(10, 2)
  pdfUrl        String?
  status        String    @default("PAID")
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, status])
}

// ============================================================================
// DOMAIN 28: SUBSCRIPTIONS & INSTITUTION BILLING
// ============================================================================

model SubscriptionPlans {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  maxStudents  Int      @default(2000)
  monthlyPrice Decimal  @db.Decimal(10, 2)
  annualPrice  Decimal  @db.Decimal(10, 2)
  features     Json?
  createdAt    DateTime @default(now())

  subscriptions Subscriptions[]
}

model Subscriptions {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  planId    String
  startDate DateTime
  endDate   DateTime
  autoRenew Boolean  @default(true)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan           SubscriptionPlans @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingRecords BillingRecords[]
}

model BillingRecords {
  id             String   @id @default(uuid())
  subscriptionId String
  amount         Decimal  @db.Decimal(10, 2)
  billingDate    DateTime @default(now())
  status         String   @default("PAID")
  invoiceId      String?

  subscription Subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, billingDate])
}

model InstitutionPayments {
  id              String   @id @default(uuid())
  tenantId        String
  amount          Decimal  @db.Decimal(10, 2)
  paymentDate     DateTime @default(now())
  paymentMode     String   @default("BANK_TRANSFER")
  referenceNumber String
  status          String   @default("VERIFIED")
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

// ============================================================================
// DOMAIN 29: MULTI-CHANNEL NOTIFICATION DISPATCHER
// ============================================================================

model Notifications {
  id        String                  @id @default(uuid())
  tenantId  String?
  userId    String
  title     String
  message   String
  channel   NotificationChannelEnum @default(IN_APP)
  isRead    Boolean                 @default(false)
  readAt    DateTime?
  createdAt DateTime                @default(now())

  deliveryLogs DeliveryLogs[]

  @@index([userId, isRead])
}

model NotificationTemplates {
  id           String                  @id @default(uuid())
  code         String                  @unique
  name         String
  channel      NotificationChannelEnum @default(EMAIL)
  subject      String
  bodyTemplate String
  variables    Json?
  createdAt    DateTime                @default(now())
}

model NotificationPreferences {
  id              String   @id @default(uuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(true)
  whatsappEnabled Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model NotificationChannels {
  id           String                  @id @default(uuid())
  channelType  NotificationChannelEnum @unique
  providerName String                  @default("TWILIO")
  credentials  Json?
  isActive     Boolean                 @default(true)
}

model DeliveryLogs {
  id               String                  @id @default(uuid())
  notificationId   String
  channel          NotificationChannelEnum
  gatewayMessageId String?
  status           String                  @default("SENT")
  errorReason      String?
  deliveredAt      DateTime?

  notification Notifications @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([gatewayMessageId])
}

model NotificationEvents {
  id        String   @id @default(uuid())
  tenantId  String?
  eventType String
  payload   Json
  createdAt DateTime @default(now())
}

// ============================================================================
// DOMAIN 30: ACADEMIC DOUBT Q&A CHAT
// ============================================================================

model AcademicConversations {
  id            String   @id @default(uuid())
  tenantId      String?
  batchId       String
  courseId      String
  studentUserId String
  title         String
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members  AcademicChatMembers[]
  messages AcademicChatMessages[]
  ticket   DoubtTickets?

  @@index([tenantId, studentUserId, status])
}

model AcademicChatMembers {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  userRole       String   @default("STUDENT")
  joinedAt       DateTime @default(now())

  conversation AcademicConversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model AcademicChatMessages {
  id             String   @id @default(uuid())
  conversationId String
  senderUserId   String
  messageType    String   @default("TEXT")
  messageText    String
  fileUrl        String?
  createdAt      DateTime @default(now())

  conversation AcademicConversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model DoubtTickets {
  id                      String    @id @default(uuid())
  conversationId          String    @unique
  tenantId                String?
  assignedAssistantUserId String?
  category                String    @default("ACADEMIC")
  priority                String    @default("MEDIUM")
  resolutionTimeMins      Int?
  resolvedAt              DateTime?
  createdAt               DateTime  @default(now())

  conversation AcademicConversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiResponses  DoubtResponses[]

  @@index([assignedAssistantUserId])
}

model DoubtResponses {
  id                   String   @id @default(uuid())
  doubtTicketId        String
  suggestedAnswerText  String
  confidenceScore      Decimal  @default(0.90) @db.Decimal(3, 2)
  wasAcceptedByStudent Boolean  @default(false)
  createdAt            DateTime @default(now())

  doubtTicket DoubtTickets @relation(fields: [doubtTicketId], references: [id], onDelete: Cascade)
}

// ============================================================================
// DOMAIN 31: TECHNICAL CUSTOMER SUPPORT
// ============================================================================

model SupportTickets {
  id           String             @id @default(uuid())
  tenantId     String?
  userId       String
  ticketNumber String             @unique
  subject      String
  description  String
  category     TicketCategoryEnum @default(LOGIN_ISSUE)
  priority     TicketPriorityEnum @default(MEDIUM)
  status       TicketStatusEnum   @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  messages      TicketMessages[]
  attachments   TicketAttachments[]
  assignments   TicketAssignments[]
  statusHistory TicketStatusHistory[]

  @@index([tenantId, status])
}

model TicketCategories {
  id                 String             @id @default(uuid())
  code               TicketCategoryEnum @unique
  name               String
  slaResolutionHours Int                @default(24)
}

model TicketMessages {
  id             String   @id @default(uuid())
  ticketId       String
  senderUserId   String
  messageText    String
  isInternalNote Boolean  @default(false)
  createdAt      DateTime @default(now())

  ticket SupportTickets @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TicketAttachments {
  id            String   @id @default(uuid())
  ticketId      String
  r2Key         String
  fileName      String
  fileSizeBytes BigInt
  createdAt     DateTime @default(now())

  ticket SupportTickets @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketAssignments {
  id                  String   @id @default(uuid())
  ticketId            String
  assignedAgentUserId String
  assignedAt          DateTime @default(now())

  ticket SupportTickets @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketStatusHistory {
  id              String           @id @default(uuid())
  ticketId        String
  fromStatus      TicketStatusEnum
  toStatus        TicketStatusEnum
  changedByUserId String
  changedAt       DateTime         @default(now())

  ticket SupportTickets @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ============================================================================
// DOMAIN 32: CAREER GUIDANCE & JOB PORTAL
// ============================================================================

model CareerPrograms {
  id               String   @id @default(uuid())
  title            String
  description      String?
  targetLanguageId String
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())

  resources CareerResources[]
}

model CareerResources {
  id           String   @id @default(uuid())
  programId    String
  title        String
  resourceType String   @default("PDF")
  r2Key        String
  createdAt    DateTime @default(now())

  program CareerPrograms @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model Companies {
  id           String   @id @default(uuid())
  name         String
  logoUrl      String?
  website      String?
  contactEmail String
  createdAt    DateTime @default(now())

  jobOpportunities JobOpportunities[]
}

model JobOpportunities {
  id                       String   @id @default(uuid())
  companyId                String
  jobTitle                 String
  requiredLanguageId       String
  requiredProficiencyLevel String   @default("B1")
  location                 String
  salaryRange              String?
  applicationDeadline      DateTime
  status                   String   @default("OPEN")
  createdAt                DateTime @default(now())

  company      Companies         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplications[]

  @@index([requiredLanguageId])
}

model StudentCareerProfiles {
  id                String   @id @default(uuid())
  studentUserId     String   @unique
  resumeR2Key       String?
  linkedInUrl       String?
  preferredRoles    Json?
  isSearchingForJob Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model JobApplications {
  id                String                   @id @default(uuid())
  jobId             String
  studentUserId     String
  applicationStatus JobApplicationStatusEnum @default(APPLIED)
  appliedAt         DateTime                 @default(now())

  job JobOpportunities @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentUserId])
}

// ============================================================================
// DOMAIN 33: STUDENT PROGRESS & LEARNING STREAKS
// ============================================================================

model StudentCourseProgress {
  id                    String   @id @default(uuid())
  tenantId              String
  studentUserId         String
  courseId              String
  completedLessonsCount Int      @default(0)
  totalLessonsCount     Int      @default(0)
  overallProgressPct    Decimal  @default(0.00) @db.Decimal(5, 2)
  lastStudiedAt         DateTime @default(now())

  @@unique([studentUserId, courseId])
}

model ActivityProgressLogs {
  id            String   @id @default(uuid())
  studentUserId String
  topicItemId   String
  timeSpentSecs Int      @default(0)
  completedAt   DateTime @default(now())

  @@unique([studentUserId, topicItemId])
}

model LSRWProgressSummaries {
  id                String   @id @default(uuid())
  studentUserId     String
  languageId        String
  listeningScorePct Decimal  @default(0.00) @db.Decimal(5, 2)
  speakingScorePct  Decimal  @default(0.00) @db.Decimal(5, 2)
  readingScorePct   Decimal  @default(0.00) @db.Decimal(5, 2)
  writingScorePct   Decimal  @default(0.00) @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt

  @@unique([studentUserId, languageId])
}

model LearningStreaks {
  id                String   @id @default(uuid())
  studentUserId     String   @unique
  currentStreakDays Int      @default(1)
  longestStreakDays Int      @default(1)
  lastActiveDate    DateTime @db.Date
  updatedAt         DateTime @updatedAt
}

model StudentAchievements {
  id            String   @id @default(uuid())
  studentUserId String
  badgeCode     String
  badgeName     String
  earnedAt      DateTime @default(now())

  @@unique([studentUserId, badgeCode])
}

// ============================================================================
// DOMAIN 34: SYSTEM ANALYTICS & REPORTS
// ============================================================================

model BatchAnalytics {
  id               String   @id @default(uuid())
  batchId          String
  weekNumber       Int
  avgAttendancePct Decimal  @default(0.00) @db.Decimal(5, 2)
  avgExamScorePct  Decimal  @default(0.00) @db.Decimal(5, 2)
  updatedAt        DateTime @updatedAt

  @@unique([batchId, weekNumber])
}

model ExamAnalytics {
  id             String   @id @default(uuid())
  examId         String   @unique
  totalAttempted Int      @default(0)
  passRatePct    Decimal  @default(0.00) @db.Decimal(5, 2)
  avgTimeSecs    Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model AIUsageAnalytics {
  id           String   @id @default(uuid())
  tenantId     String
  analyticDate DateTime @db.Date
  totalTokens  BigInt   @default(0)
  totalCostUSD Decimal  @default(0.0000) @db.Decimal(10, 4)
  avgLatencyMs Int      @default(0)

  @@unique([tenantId, analyticDate])
}

model InstitutionReports {
  id          String   @id @default(uuid())
  tenantId    String
  reportType  String   @default("ATTENDANCE")
  r2ReportKey String
  generatedAt DateTime @default(now())
}

// ============================================================================
// DOMAIN 35: ENTERPRISE AUDIT LOGS & SECURITY
// ============================================================================

model AuditLogs {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String   @default("UPDATE")
  entityName String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String
  createdAt  DateTime @default(now())

  @@index([tenantId, entityName, createdAt])
}

model LoginLogs {
  id              String   @id @default(uuid())
  tenantId        String?
  userId          String
  authMethod      String   @default("PASSWORD")
  ipAddress       String
  locationCountry String?
  createdAt       DateTime @default(now())
}

model SecurityEvents {
  id        String   @id @default(uuid())
  tenantId  String?
  eventType String
  severity  String   @default("HIGH")
  details   Json
  createdAt DateTime @default(now())

  @@index([severity])
}

model APIAccessLogs {
  id             String   @id @default(uuid())
  tenantId       String?
  userId         String?
  endpoint       String
  httpMethod     String   @default("GET")
  statusCode     Int      @default(200)
  responseTimeMs Int      @default(0)
  createdAt      DateTime @default(now())
}

model PermissionChangeLogs {
  id                String   @id @default(uuid())
  tenantId          String
  modifiedRoleId    String
  modifiedByUserId  String
  permissionAdded   String?
  permissionRemoved String?
  changedAt         DateTime @default(now())
}

// ============================================================================
// DOMAIN 36: SYSTEM CONFIGURATIONS
// ============================================================================

model SystemSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model FeatureFlags {
  id                String   @id @default(uuid())
  featureKey        String   @unique
  isEnabled         Boolean  @default(false)
  rolloutPercentage Int      @default(100)
  tenantWhitelist   Json?
  updatedAt         DateTime @updatedAt
}

model MaintenanceWindows {
  id        String   @id @default(uuid())
  title     String
  startTime DateTime
  endTime   DateTime
  status    String   @default("SCHEDULED")
  createdAt DateTime @default(now())
}
