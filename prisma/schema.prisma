  RECORDED_SESSION
  HYBRID
}

enum LiveClassStatusEnum {
  SCHEDULED
  WAITING
  LIVE
  PAUSED
  ENDED
  CANCELLED
}

enum ParticipantRoleEnum {
  HOST
  CO_HOST
  ASSISTANT
  STUDENT
  GUEST
