// ============================================================================
// DOMAIN 1: MULTI-TENANT ORGANIZATION MANAGEMENT
// ============================================================================

model Institutions {
  id          String            @id @default(uuid())
  code        String            @unique
  slug        String            @unique
  name        String
  displayName String
  email       String            @unique
  phone       String
  website     String?
  logoFileId  String?
  status      InstitutionStatus @default(ACTIVE)
  timezone    String            @default("Asia/Kolkata")
  currency    String            @default("INR")
  createdAt   DateTime          @default(now())
  createdBy   String?
  updatedAt   DateTime          @updatedAt
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?
  version     Int               @default(1)

  campuses        Campuses[]
  departments     Departments[]
  academicYears   AcademicYears[]
  settings        InstitutionSettings?
  domains         InstitutionDomains[]
  subscriptions   InstitutionSubscriptions[]
  branding        InstitutionBranding?
  users           Users[]
  roles           Roles[]
  studentProfiles StudentProfiles[]
  tutorProfiles   TutorProfiles[]

  @@index([status])
  @@index([deletedAt])
}

model Campuses {
  id           String    @id @default(uuid())
  tenantId     String
  code         String
  name         String
  address      String?
  city         String
  state        String
  country      String    @default("India")
  pincode      String
  contactEmail String?
  contactPhone String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  createdBy    String?
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  tenant      Institutions  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Departments[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Departments {
  id           String    @id @default(uuid())
  tenantId     String
  campusId     String?
  code         String
  name         String
  description  String?
  displayOrder Int       @default(1)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  createdBy    String?
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
  deletedAt    DateTime?

  tenant Institutions @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campuses?    @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, campusId])
}

model AcademicYears {
  id        String   @id @default(uuid())
  tenantId  String
  code      String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  tenant Institutions @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, isCurrent])
}

model InstitutionSettings {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  themeConfig           Json?
  authSettings          Json?
  notificationSettings  Json?
  maxSessionTimeoutMins Int      @default(60)
  enable2FA             Boolean  @default(false)
  updatedAt             DateTime @updatedAt
  updatedBy             String?

  tenant Institutions @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model InstitutionDomains {
  id         String   @id @default(uuid())
  tenantId   String
  domain     String   @unique
  isVerified Boolean  @default(false)
  sslStatus  String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  tenant Institutions @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InstitutionSubscriptions {
  id                 String   @id @default(uuid())
  tenantId           String
  planName           String
  maxStudentsAllowed Int      @default(2000)
  maxStorageGB       Int      @default(500)
  startDate          DateTime
  endDate            DateTime
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Institutions @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model InstitutionBranding {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#0F172A")
  secondaryColor String   @default("#2563EB")
  cssOverrides   String?
  updatedAt      DateTime @updatedAt

  tenant Institutions @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ============================================================================
// DOMAIN 2: USER IDENTITY, AUTHENTICATION & SESSIONS
// ============================================================================

model Users {
  id                  String         @id @default(uuid())
  tenantId            String
  email               String
  phone               String?
  firstName           String
  lastName            String
  userType            UserTypeEnum
  status              UserStatusType @default(PENDING)
  isSuperAdmin        Boolean        @default(false)
  passwordHash        String
  forcePasswordChange Boolean        @default(false)
  failedAttempts      Int            @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime       @default(now())
  createdBy           String?
  updatedAt           DateTime       @updatedAt
  updatedBy           String?
  deletedAt           DateTime?

  tenant                Institutions            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userSessions          UserSessions[]
  loginHistory          LoginHistory[]
  userDevices           UserDevices[]
  userPreferences       UserPreferences?
  emergencyContacts     EmergencyContacts[]
  userRoles             UserRoles[]
  studentProfile        StudentProfiles?
  tutorProfile          TutorProfiles?
  assistantTutorProfile AssistantTutorProfiles?
  collegeAdminProfile   CollegeAdminProfiles?
  superAdminProfile     SuperAdminProfiles?

  @@unique([tenantId, email])
  @@index([tenantId, userType, status])
  @@index([deletedAt])
}

model UserSessions {
  id                String            @id @default(uuid())
  tenantId          String
  userId            String
  deviceFingerprint String?
  deviceName        String?
  ipAddress         String
  deviceType        String?
  browserName       String?
  osName            String?
  status            SessionStatusType @default(ACTIVE)
  refreshTokenHash  String
  lastActiveAt      DateTime          @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?
  createdAt         DateTime          @default(now())

  user          Users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshTokens[]

  @@index([userId, status])
  @@index([refreshTokenHash])
}

model RefreshTokens {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  tokenHash String   @unique
  familyId  String
  isUsed    Boolean  @default(false)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  session UserSessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([familyId])
}

model OTPVerifications {
  id         String   @id @default(uuid())
  tenantId   String
  identifier String
  otpHash    String
  purpose    String   @default("LOGIN")
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId, identifier, purpose])
}

model PasswordResetTokens {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  hashedToken String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([hashedToken])
  @@index([userId, expiresAt])
}

model LoginHistory {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  sessionId     String?
  ipAddress     String
  userAgent     String?
  status        String   @default("SUCCESS")
  failureReason String?
  loginAt       DateTime @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, loginAt])
}

model UserDevices {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  deviceToken String
  platform    String   @default("WEB")
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceToken])
}

model UserPreferences {
  id                   String   @id @default(uuid())
  userId               String   @unique
  locale               String   @default("en")
  theme                String   @default("light")
  notificationSettings Json?
  updatedAt            DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContacts {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  name         String
  relationship String
  phone        String
  email        String?
  address      String?
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// ============================================================================
// DOMAIN 3: DYNAMIC MENU-BASED RBAC ENGINE
// ============================================================================

model Menus {
  id            String       @id @default(uuid())
  parentId      String?
  code          String       @unique
  name          String
  route         String?
  iconKey       String?
  pageTitle     String?
  menuType      MenuNodeType @default(MENU)
  displayOrder  Int          @default(1)
  showInSidebar Boolean      @default(true)
  isVisible     Boolean      @default(true)
  isSystem      Boolean      @default(true)
  isActive      Boolean      @default(true)
  featureFlag   String?
  createdAt     DateTime     @default(now())
  createdBy     String?
  updatedAt     DateTime     @updatedAt
  updatedBy     String?

  parentMenu       Menus?               @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  childMenus       Menus[]              @relation("MenuHierarchy")
  roleVisibilities RoleMenuVisibility[]

  @@index([parentId, displayOrder])
}

model PermissionGroups {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())

  permissions Permissions[]
}

model Permissions {
  id                String           @id @default(uuid())
  permissionGroupId String?
  permissionKey     String           @unique
  resource          String
  action            PermissionAction
  description       String?
  scope             String           @default("TENANT")
  createdAt         DateTime         @default(now())

  permissionGroup PermissionGroups? @relation(fields: [permissionGroupId], references: [id], onDelete: SetNull)
  rolePermissions RolePermissions[]

  @@index([resource, action])
}

model Roles {
  id          String   @id @default(uuid())
  tenantId    String
  code        String
  name        String
  roleType    RoleType @default(CUSTOM)
  priority    Int      @default(1)
  isDefault   Boolean  @default(false)
  isEditable  Boolean  @default(true)
  isDeletable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Institutions         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleVisibilities RoleMenuVisibility[]
  rolePermissions  RolePermissions[]
  userRoles        UserRoles[]

  @@unique([tenantId, code])
  @@index([tenantId, priority])
}

model RoleMenuVisibility {
  id        String   @id @default(uuid())
  tenantId  String
  roleId    String
  menuId    String
  isGranted Boolean  @default(true)
  createdAt DateTime @default(now())

  role Roles @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu Menus @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@index([tenantId, roleId])
}

model RolePermissions {
  id           String   @id @default(uuid())
  tenantId     String
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId, roleId])
}

model UserRoles {
  id               String    @id @default(uuid())
  tenantId         String
  userId           String
  roleId           String
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  assignedBy       String?
  assignmentReason String?
  revokedBy        String?
  revokedReason    String?
  createdAt        DateTime  @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Roles @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId, userId, effectiveFrom])
}

// ============================================================================
// DOMAIN 4: CORE USER PROFILES
// ============================================================================

model StudentProfiles {
  userId               String             @id
  tenantId             String
  studentCode          String
  admittedAt           DateTime           @default(now())
  dateOfBirth          DateTime
  gender               GenderType
  bloodGroup           BloodGroupType?
  academicStatus       AcademicStatusEnum @default(ACTIVE)
  profileCompletionPct Decimal            @default(0.00) @db.Decimal(5, 2)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user   Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Institutions @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentCode])
  @@index([tenantId, academicStatus])
}

model TutorProfiles {
  userId               String   @id
  tenantId             String
  tutorCode            String
  qualification        String
  specialization       String
  bio                  String?
  rating               Decimal  @default(5.00) @db.Decimal(3, 2)
  totalClassesTaught   Int      @default(0)
  isMainTutor          Boolean  @default(true)
  isSubstituteEligible Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Institutions @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tutorCode])
  @@index([tenantId, isMainTutor])
}

model AssistantTutorProfiles {
  userId              String   @id
  tenantId            String
  assistantCode       String
  assignedColleges    Json?
  maxConcurrentDoubts Int      @default(10)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, assistantCode])
}

model CollegeAdminProfiles {
  userId       String   @id
  tenantId     String
  departmentId String?
  designation  String
  officePhone  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SuperAdminProfiles {
  userId      String   @id
  accessLevel String   @default("FULL_SYSTEM")
  createdAt   DateTime @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// DOMAIN 5: FOREIGN LANGUAGES ENGINE
// ============================================================================

model Languages {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  nativeName      String
  flagUrl         String?
  defaultAccents  Json?
  sttLanguageCode String   @default("fr-FR")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants          LanguageVariants[]
  proficiencyLevels LanguageProficiencyLevels[]
  settings          LanguageSettings?
  courses           Courses[]

  @@index([code, isActive])
}

model LanguageVariants {
  id          String   @id @default(uuid())
  languageId  String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())

  language Languages @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([languageId, code])
}

model LanguageProficiencyLevels {
  id           String   @id @default(uuid())
  languageId   String
  code         String
  name         String
  description  String?
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())

  language Languages @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([languageId, code])
}

model LanguageSettings {
  id                        String   @id @default(uuid())
  languageId                String   @unique
  virtualKeyboardLayout     Json?
  audioSampleRate           Int      @default(16000)
  pronunciationScoreWeights Json?
  updatedAt                 DateTime @updatedAt

  language Languages @relation(fields: [languageId], references: [id], onDelete: Cascade)
}

// ============================================================================
// DOMAIN 6: COURSE ARCHITECTURE
// ============================================================================

model CourseCategories {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())

  courses Courses[]
}

model Courses {
  id           String           @id @default(uuid())
  tenantId     String?
  languageId   String
  categoryId   String?
  code         String
  name         String
  displayName  String
  description  String?
  totalHours   Int              @default(100)
  courseType   CourseTypeEnum   @default(REGULAR)
  status       CourseStatusEnum @default(DRAFT)
  displayOrder Int              @default(1)
  isSystem     Boolean          @default(false)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  language         Languages                @relation(fields: [languageId], references: [id], onDelete: Restrict)
  category         CourseCategories?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  levels           CourseLevels[]
  versions         CourseVersions[]
  modules          CourseModules[]
  durationPatterns CourseDurationPatterns[]
  prerequisites    CoursePrerequisites[]    @relation("MainCourse")
  prerequisiteOf   CoursePrerequisites[]    @relation("PrereqCourse")

  @@unique([tenantId, code])
  @@index([languageId, status])
}

model CourseLevels {
  id         String   @id @default(uuid())
  courseId   String
  levelCode  String
  name       String
  totalHours Int      @default(100)
  createdAt  DateTime @default(now())

  course    Courses           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subLevels CourseSubLevels[]

  @@unique([courseId, levelCode])
}

model CourseSubLevels {
  id             String   @id @default(uuid())
  courseLevelId  String
  subLevelCode   String
  name           String
  hoursAllocated Int      @default(50)
  displayOrder   Int      @default(1)
  createdAt      DateTime @default(now())

  courseLevel CourseLevels @relation(fields: [courseLevelId], references: [id], onDelete: Cascade)

  @@unique([courseLevelId, subLevelCode])
}

model CourseVersions {
  id            String   @id @default(uuid())
  courseId      String
  versionNumber Int      @default(1)
  changelog     String?
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  course Courses @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, versionNumber])
}

model CourseModules {
  id           String   @id @default(uuid())
  courseId     String
  code         String
  name         String
  description  String?
  displayOrder Int      @default(1)
  plannedHours Int      @default(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course      Courses              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  units       CourseUnits[]
  pacingRules PatternPacingRules[]

  @@unique([courseId, code])
  @@index([courseId, displayOrder])
}

model CourseUnits {
  id           String   @id @default(uuid())
  moduleId     String
  code         String
  name         String
  description  String?
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())

  module  CourseModules @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons Lessons[]

  @@unique([moduleId, code])
}

model Lessons {
  id                    String   @id @default(uuid())
  unitId                String
  code                  String
  title                 String
  summary               String?
  displayOrder          Int      @default(1)
  estimatedDurationMins Int      @default(120)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  unit   CourseUnits @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topics Topics[]

  @@unique([unitId, code])
  @@index([unitId, displayOrder])
}

// ============================================================================
// DOMAIN 7: CURRICULUM & TOPICS
// ============================================================================

model Topics {
  id                 String              @id @default(uuid())
  lessonId           String
  code               String
  name               String
  description        String?
  learningObjectives String?
  difficultyLevel    DifficultyLevelEnum @default(MEDIUM)
  displayOrder       Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  lesson     Lessons              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topicItems TopicItems[]
  objectives LearningObjectives[]

  @@unique([lessonId, code])
}

model TopicItems {
  id             String             @id @default(uuid())
  topicId        String
  itemType       TopicItemTypeEnum
  title          String
  description    String?
  content        Json?
  fileStorageUrl String?
  externalUrl    String?
  durationMins   Int?
  displayOrder   Int                @default(1)
  completionRule CompletionRuleEnum @default(NONE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  topic Topics @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, displayOrder])
}

model LearningObjectives {
  id             String   @id @default(uuid())
  topicId        String
  code           String
  objectiveText  String
  cognitiveLevel String   @default("UNDERSTAND")
  createdAt      DateTime @default(now())

  topic Topics @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, code])
}

model CoursePrerequisites {
  id                   String   @id @default(uuid())
  courseId             String
  prerequisiteCourseId String
  minGradeRequired     Decimal? @db.Decimal(5, 2)
  createdAt            DateTime @default(now())

  course             Courses @relation("MainCourse", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse Courses @relation("PrereqCourse", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
}

// ============================================================================
// DOMAIN 8: THREE COURSE DURATION PATTERNS
// ============================================================================

model CourseDurationPatterns {
  id             String                  @id @default(uuid())
  courseId       String
  patternCode    DurationPatternTypeEnum @default(TWELVE_MONTHS)
  name           String
  totalWeeks     Int                     @default(50)
  classesPerWeek Int                     @default(1)
  hoursPerClass  Int                     @default(2)
  totalHours     Int                     @default(100)
  isDefault      Boolean                 @default(false)
  createdAt      DateTime                @default(now())

  course      Courses              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  schedules   PatternSchedules[]
  pacingRules PatternPacingRules[]

  @@unique([courseId, patternCode])
}

model PatternSchedules {
  id                 String   @id @default(uuid())
  patternId          String
  dayOfWeekNumber    Int
  suggestedStartTime String
  suggestedEndTime   String
  createdAt          DateTime @default(now())

  pattern CourseDurationPatterns @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([patternId, dayOfWeekNumber])
}

model PatternPacingRules {
  id               String   @id @default(uuid())
  patternId        String
  moduleId         String
  targetWeekNumber Int
  lessonsPerWeek   Int      @default(1)
  createdAt        DateTime @default(now())

  pattern CourseDurationPatterns @relation(fields: [patternId], references: [id], onDelete: Cascade)
  module  CourseModules          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([patternId, moduleId])
}

// ============================================================================
// DOMAIN 9: BATCHES & MULTI-COLLEGE ENROLLMENT ENGINE
// ============================================================================

model Batches {
  id                String          @id @default(uuid())
  tenantId          String?
  courseId          String
  durationPatternId String
  code              String          @unique
  name              String
  maxStudents       Int             @default(500)
  startDate         DateTime
  endDate           DateTime
  status            BatchStatusEnum @default(UPCOMING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  batchInstitutions BatchInstitutions[]
  batchSchedules    BatchSchedules[]
  batchTutors       BatchTutors[]
  enrollments       StudentBatchEnrollments[]
  liveClasses       LiveClasses[]
  recordings        Recordings[]

  @@index([courseId, status])
  @@index([startDate, endDate])
}

model BatchInstitutions {
  id                String   @id @default(uuid())
  batchId           String
  institutionId     String
  maxSeatsAllocated Int      @default(100)
  assignedAt        DateTime @default(now())

  batch Batches @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, institutionId])
  @@index([institutionId])
}

model BatchSchedules {
  id              String   @id @default(uuid())
  batchId         String
  dayOfWeekNumber Int
  startTime       String
  endTime         String
  createdAt       DateTime @default(now())

  batch Batches @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, dayOfWeekNumber])
}

model BatchTutors {
  id            String             @id @default(uuid())
  batchId       String
  tutorUserId   String
  tutorRole     TutorBatchRoleEnum @default(MAIN_TUTOR)
  institutionId String?
  createdAt     DateTime           @default(now())

  batch Batches @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, tutorUserId, tutorRole])
  @@index([batchId, tutorRole])
}

model StudentBatchEnrollments {
  id                String                      @id @default(uuid())
  tenantId          String
  studentUserId     String
  batchId           String
  enrollmentNumber  String                      @unique
  joinedAt          DateTime                    @default(now())
  leftAt            DateTime?
  status            StudentEnrollmentStatusEnum @default(ACTIVE)
  validityExpiresAt DateTime
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  batch   Batches             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  history EnrollmentHistory[]

  @@unique([studentUserId, batchId])
  @@index([tenantId, studentUserId, status])
  @@index([validityExpiresAt])
}

model EnrollmentHistory {
  id              String                      @id @default(uuid())
  enrollmentId    String
  fromStatus      StudentEnrollmentStatusEnum
  toStatus        StudentEnrollmentStatusEnum
  reason          String?
  changedByUserId String?
  changedAt       DateTime                    @default(now())

  enrollment StudentBatchEnrollments @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

// ============================================================================
// DOMAIN 10: TIMETABLE & SCHEDULING
// ============================================================================

model Timetables {
  id        String   @id @default(uuid())
  tenantId  String
  code      String
