  PDF
  AUDIO
  VIDEO
  LINK
  LSRW_EXERCISE
  ASSESSMENT
  VIRTUAL_KEYBOARD_PRACTICE
}

enum CompletionRuleEnum {
  NONE
  OPEN
  WATCH_80_PERCENT
  WATCHED_FULL
  PASS_QUIZ
}

enum DurationPatternTypeEnum {
  TWELVE_MONTHS // Option 1: 1 day/wk, 2 hrs/day (~50 weeks)
  SIX_MONTHS // Option 2: 2 days/wk, 2 hrs/day (~25 weeks)
  THREE_MONTHS // Option 3: 3 days/wk, 2 hrs/day (~13 weeks)
  CUSTOM
}

enum BatchStatusEnum {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum TutorBatchRoleEnum {
  MAIN_TUTOR
  SUBSTITUTE_TUTOR
  ASSISTANT_TUTOR
