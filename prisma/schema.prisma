  createdAt         DateTime @default(now())

  @@unique([tenantId, holidayDate])
}

model ScheduleExceptions {
  id                String    @id @default(uuid())
  scheduleEntryId   String
  originalDate      DateTime
  overrideDate      DateTime?
  overrideStartTime String?
  overrideEndTime   String?
  reason            String?
  overrideType      String    @default("RESCHEDULED")
  createdAt         DateTime  @default(now())

  scheduleEntry ScheduleEntries @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)

  @@index([scheduleEntryId, originalDate])
}

model CalendarEvents {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  eventTitle  String
  eventDate   DateTime
  startTime   String
  endTime     String
  eventType   String   @default("WEBINAR")
  referenceId String?
  createdAt   DateTime @default(now())

  @@index([userId, eventDate])
}

// ============================================================================
// DOMAIN 11: LIVEKIT WEBINAR CLASSROOM SYSTEM
// ============================================================================

model LiveClasses {
  id                    String              @id @default(uuid())
  tenantId              String?
  batchId               String
  title                 String
  scheduledStartTime    DateTime
  scheduledEndTime      DateTime
  actualStartTime       DateTime?
  actualEndTime         DateTime?
  status                LiveClassStatusEnum @default(SCHEDULED)
  mainTutorUserId       String
  substituteTutorUserId String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  batch              Batches               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sessions           LiveSessions[]
  accessLogs         LiveClassAccessLogs[]
  attendanceSessions AttendanceSessions[]
  recordings         Recordings[]

  @@index([batchId, scheduledStartTime])
  @@index([status])
}

model LiveSessions {
  id               String    @id @default(uuid())
  liveClassId      String
  livekitRoomName  String    @unique
  livekitRoomSid   String?
  hostJoinedAt     DateTime?
  hostLeftAt       DateTime?
  sessionEndReason String?
  createdAt        DateTime  @default(now())

  liveClass    LiveClasses             @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  rooms        LiveKitRooms[]
  participants LiveClassParticipants[]
  classEvents  ClassEvents[]

  @@index([liveClassId])
}

model LiveKitRooms {
  id                String   @id @default(uuid())
  liveSessionId     String
  roomSid           String   @unique
  maxParticipants   Int      @default(500)
  isRecordingActive Boolean  @default(false)
  chatMuted         Boolean  @default(true)
  videoMuted        Boolean  @default(true)
  createdAt         DateTime @default(now())

  liveSession LiveSessions @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
}

model LiveClassParticipants {
  id                  String              @id @default(uuid())
  liveSessionId       String
  userId              String
  participantRole     ParticipantRoleEnum @default(STUDENT)
  joinedAt            DateTime            @default(now())
  leftAt              DateTime?
  totalDurationSecs   Int                 @default(0)
  networkQualityScore Decimal?            @db.Decimal(3, 2)
  createdAt           DateTime            @default(now())

  liveSession LiveSessions @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@index([liveSessionId, userId])
}

model LiveClassAccessLogs {
  id            String   @id @default(uuid())
  liveClassId   String
  userId        String
  tokenIssuedAt DateTime @default(now())
  clientIp      String
  accessGranted Boolean  @default(true)

  liveClass LiveClasses @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@index([liveClassId, userId])
}

model AttendanceSessions {
  id                   String               @id @default(uuid())
  tenantId             String
  liveClassId          String
  studentUserId        String
  batchId              String
  attendanceStatus     AttendanceStatusEnum @default(ABSENT)
  watchDurationMins    Int                  @default(0)
  attendancePercentage Decimal              @default(0.00) @db.Decimal(5, 2)
  createdAt            DateTime             @default(now())

  liveClass LiveClasses @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentUserId])
  @@index([tenantId, studentUserId, attendanceStatus])
}

model ClassEvents {
  id                String   @id @default(uuid())
  liveSessionId     String
  eventType         String
  triggeredByUserId String?
  payload           Json?
  createdAt         DateTime @default(now())

  liveSession LiveSessions @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@index([liveSessionId, eventType])
}

// ============================================================================
// DOMAIN 12: CLOUDFLARE R2 RECORDING PROCESSING PIPELINE
// ============================================================================

model Recordings {
  id                String              @id @default(uuid())
  tenantId          String?
  liveClassId       String
  batchId           String
  title             String
  recordingStatus   RecordingStatusEnum @default(SCHEDULED)
  durationSecs      Int                 @default(0)
  uploadSlaDeadline DateTime
  validityExpiresAt DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  liveClass      LiveClasses               @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  batch          Batches                   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recordingFiles RecordingFiles[]
  versions       RecordingVersions[]
  jobs           RecordingProcessingJobs[]
  accessLogs     RecordingAccessLogs[]

  @@index([liveClassId, recordingStatus])
  @@index([validityExpiresAt])
}

model RecordingFiles {
  id            String   @id @default(uuid())
  recordingId   String
  r2StorageKey  String   @unique
  fileType      String   @default("MP4_VIDEO")
  fileSizeBytes BigInt
  signedUrl     String?
  resolution    String   @default("720p")
  createdAt     DateTime @default(now())

  recording Recordings @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
}

model RecordingVersions {
  id          String   @id @default(uuid())
  recordingId String
  resolution  String   @default("720p")
  bitrateKbps Int      @default(1500)
  r2Url       String
  createdAt   DateTime @default(now())

  recording Recordings @relation(fields: [recordingId], references: [id], onDelete: Cascade)
}

model RecordingProcessingJobs {
  id          String        @id @default(uuid())
  recordingId String
  jobId       String        @unique
  queueName   String        @default("recording-processing")
  status      JobStatusEnum @default(QUEUED)
  attempts    Int           @default(0)
  errorReason String?
  startedAt   DateTime?
  completedAt DateTime?

  recording Recordings @relation(fields: [recordingId], references: [id], onDelete: Cascade)
}

model RecordingAccessLogs {
  id                  String   @id @default(uuid())
  tenantId            String
  recordingId         String
  studentUserId       String
  watchDurationSecs   Int      @default(0)
  maxSeekPositionSecs Int      @default(0)
  completedPct        Decimal  @default(0.00) @db.Decimal(5, 2)
  lastWatchedAt       DateTime @default(now())

  recording Recordings                @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  history   RecordingViewingHistory[]

  @@unique([recordingId, studentUserId])
  @@index([tenantId, studentUserId])
}

model RecordingViewingHistory {
  id                   String   @id @default(uuid())
  recordingAccessLogId String
  timestampSecs        Int
  eventType            String   @default("PLAY")
  recordedAt           DateTime @default(now())

  accessLog RecordingAccessLogs @relation(fields: [recordingAccessLogId], references: [id], onDelete: Cascade)

  @@index([recordingAccessLogId, recordedAt])
}

// ============================================================================
// DOMAIN 13: LEARNING RESOURCE BANK & FILES
