  tenantId        String
  batchId         String
  timetableId     String?
  dayOfWeekNumber Int
  startTime       String
  endTime         String
  deliveryMode    DeliveryModeEnum @default(ONLINE_WEBINAR)
  createdAt       DateTime         @default(now())

  timetable  Timetables?          @relation(fields: [timetableId], references: [id], onDelete: SetNull)
  exceptions ScheduleExceptions[]

  @@index([batchId, dayOfWeekNumber])
}

model TutorAvailabilities {
  id              String   @id @default(uuid())
  tutorUserId     String
  dayOfWeekNumber Int
  startTime       String
  endTime         String
  isAvailable     Boolean  @default(true)
