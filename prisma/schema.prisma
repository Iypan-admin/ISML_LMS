// ============================================================================
// ISML LMS v1.0 — Master Enterprise Prisma Schema
// Enterprise Multi-Tenant Foreign Language Learning System
// Target: 100+ Production Models (Actual: 195 Business-Justified Models)
// 15+ Years Database Architecture Standards (PostgreSQL + Supabase + pgvector)
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ============================================================================
// MASTER ENUMS
// ============================================================================

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserTypeEnum {
  STAFF
  STUDENT
  PARENT
  TUTOR
  SUPER_ADMIN
}

enum UserStatusType {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SessionStatusType {
  ACTIVE
  EXPIRED
  REVOKED
}

enum MenuNodeType {
  MODULE
  GROUP
  MENU
  ACTION
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  VIEW
  EXPORT
  APPROVE
  MANAGE
  EXECUTE
}

enum RoleType {
  SYSTEM
  CUSTOM
}

enum GenderType {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroupType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

enum AcademicStatusEnum {
  ACTIVE
  SUSPENDED
  PASSED_OUT
  DROPPED
  WITHDRAWN
}

enum CourseTypeEnum {
  REGULAR
  CRASH_COURSE
  DIPLOMA
  CERTIFICATION
  WORKSHOP
}

enum CourseStatusEnum {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DifficultyLevelEnum {
  BEGINNER
  EASY
  MEDIUM
  HARD
  ADVANCED
}

enum TopicItemTypeEnum {
