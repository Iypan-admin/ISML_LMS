enum AttendanceStatusEnum {
  PRESENT
  ABSENT
  PARTIAL
  EXCUSED
}

enum RecordingStatusEnum {
  SCHEDULED
  RECORDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
